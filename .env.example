# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so your real secret never gets committed.

# The Web app URL from Apps Script (Deploy → Manage deployments). Ends in /exec.
SHEET_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# The same value as the SECRET script property in your Apps Script.
SHEET_SECRET=replace-with-your-secret
