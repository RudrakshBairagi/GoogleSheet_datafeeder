{
  "name": "sheet-feeder",
  "version": "1.0.0",
  "description": "Send rows of data to a Google Sheet from Node.js using a Google Apps Script web app. No API keys, no dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "sheet-feeder": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "apps-script"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "keywords": [
    "google-sheets",
    "apps-script",
    "spreadsheet",
    "logging",
    "webhook"
  ],
  "author": "RudrakshBairagi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrakshBairagi/GoogleSheet_datafeeder.git"
  },
  "bugs": {
    "url": "https://github.com/RudrakshBairagi/GoogleSheet_datafeeder/issues"
  },
  "homepage": "https://github.com/RudrakshBairagi/GoogleSheet_datafeeder#readme"
}
